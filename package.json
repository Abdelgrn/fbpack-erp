{
  "name": "fbpack-erp-local-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Build tools for local Tailwind CSS and Chart.js assets used by FB PACK ERP.",
  "scripts": {
    "build:assets": "tailwindcss --config ./tailwind.config.cjs --input ./static/src/tailwind.css --output ./static/css/tailwind.min.css --minify && node ./scripts/copy-chart.js"
  },
  "devDependencies": {
    "chart.js": "4.6.1",
    "tailwindcss": "3.4.19"
  }
}
